        <mxCell id="5FklwkIapEe6_gSHQEIQ-173" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(122, 0, 0), rgb(237, 237, 237));&quot;&gt;ЦЕЛИ НА ГОД&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(122, 0, 0), rgb(237, 237, 237));&quot;&gt;Автоматизированное открытие депозитного продукта в ДБО&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(122, 0, 0), rgb(237, 237, 237));&quot;&gt;Открытие депозитного продукта без участия сотрудников бэк-офиса&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;rounded=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=2;labelPosition=center;verticalLabelPosition=middle;spacingTop=2;spacingLeft=10;spacingBottom=2;spacingRight=2;" vertex="1" parent="5FklwkIapEe6_gSHQEIQ-14">
